# Copia este archivo a .env y ajusta los valores según tu entorno.
# .env nunca debe subirse a GitHub (ya está en .gitignore).

# Desarrollo local (SQLite, sin instalación adicional):
DATABASE_URL="file:./dev.db"

# Producción (ejemplo con PostgreSQL — descomentar y ajustar cuando se despliegue):
# DATABASE_URL="postgresql://usuario:password@host:5432/nombre_basedatos"

PORT=3000

# API deportiva (ver arquitectura_tecnica.md, sección 1)
API_FOOTBALL_KEY="tu_api_key_aqui"
